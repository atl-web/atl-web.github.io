---
import Layout from '../layouts/Layout.astro';
import MaterialGrid from '../components/MaterialGrid.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { materialGroups } from '../lib/material';

const materials = await getCollection('materials');
const groups = materialGroups(materials, 'examenes');
---

<Layout
  title="Exámenes: programas y apuntes · Taekwondo Huracán"
  description="Programas de examen por grado y Dan, y material de estudio del Taekwondo: historia, protocolo y ceremonial.">
  <section class="section" aria-labelledby="page-title">
    <div class="wrap">
      <p class="eyebrow">Material</p>
      <h1 class="section-title" id="page-title">Exámenes: programas y apuntes</h1>
      <p class="lede">
        Programas de examen de Gups y Danes, y material de estudio. Cada tarjeta abre el PDF.
      </p>
      <MaterialGrid groups={groups} labelTag="h2" titleTag="h3" />
      <p class="cta-row">
        <a class="btn btn--ghost" href="/">
          <Icon name="caret-left" size={18} />
          Volver al inicio
        </a>
        <a class="btn btn--ghost" href="/formas">
          Ver formas
          <Icon name="caret-right" size={18} />
        </a>
      </p>
    </div>
  </section>
</Layout>
