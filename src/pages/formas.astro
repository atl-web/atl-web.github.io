---
import Layout from '../layouts/Layout.astro';
import MaterialGrid from '../components/MaterialGrid.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const materials = await getCollection('materials');
const items = materials.filter((entry) => entry.data.group === 'formas').map((entry) => entry.data);
const sections = [...new Set(items.map((item) => item.section))];
const groups = sections.map((section) => ({
  section,
  items: items.filter((item) => item.section === section),
}));
---

<Layout
  title="Formas (poomsae) · Taekwondo Huracán"
  description="Formas de Taekwondo WT: Taegeuk 1 a 8 y formas de Danes (Koryo, Keumgang, Taebaek) con videos.">
  <section class="section" aria-labelledby="page-title">
    <div class="wrap">
      <p class="eyebrow">Material</p>
      <h1 class="section-title" id="page-title">Formas</h1>
      <p class="lede">
        Poomsae Taegeuk de la WT y las formas de Danes. Cada tarjeta abre el video en YouTube.
      </p>
      <MaterialGrid groups={groups} labelTag="h2" titleTag="h3" />
      <p class="cta-row">
        <a class="btn btn--ghost" href="/">
          <Icon name="caret-left" size={18} />
          Volver al inicio
        </a>
        <a class="btn btn--ghost" href="/traducciones">
          Ver traducciones
          <Icon name="caret-right" size={18} />
        </a>
      </p>
    </div>
  </section>
</Layout>
