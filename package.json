{
  "name": "tkd-huracan",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit.mjs",
    "links": "node scripts/links.mjs",
    "images": "node scripts/build-images.mjs",
    "lighthouse:home-mobile": "npx lighthouse http://localhost:4321/ --output=json --output-path=verify/lighthouse-home-mobile.json --form-factor=mobile --emulated-form-factor=mobile --screenEmulation.mobile=true --chrome-path=/usr/bin/google-chrome --chrome-flags=\"--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage\" --quiet --only-categories=performance,accessibility,best-practices,seo",
    "lighthouse:home-desktop": "npx lighthouse http://localhost:4321/ --output=json --output-path=verify/lighthouse-home-desktop.json --form-factor=desktop --emulated-form-factor=desktop --screenEmulation.mobile=false --screenEmulation.width=1280 --screenEmulation.height=900 --screenEmulation.deviceScaleFactor=1 --chrome-path=/usr/bin/google-chrome --chrome-flags=\"--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage\" --quiet --only-categories=performance,accessibility,best-practices,seo",
    "lighthouse:pages": "bash scripts/lighthouse-pages.sh"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.2.5",
    "@fontsource/source-sans-3": "^5.2.5",
    "@phosphor-icons/core": "^2.0.11",
    "astro": "^7.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
